@TransactionService_HostAddress = http://localhost:5002

### List transactions (paginated)
GET {{TransactionService_HostAddress}}/api/transactions?page=1&pageSize=10
Accept: application/json

### Filter by type and date range
GET {{TransactionService_HostAddress}}/api/transactions?type=SALE&dateFrom=2026-10-01T05:00:00Z&dateTo=2026-10-31T05:00:00Z

### Single day (inclusive)
GET {{TransactionService_HostAddress}}/api/transactions?dateFrom=2026-08-05T05:00:00Z&dateTo=2026-08-05T05:00:00Z

### History of one product
GET {{TransactionService_HostAddress}}/api/transactions?productId=1

### Get transaction by id
GET {{TransactionService_HostAddress}}/api/transactions/1

### Invalid range
GET {{TransactionService_HostAddress}}/api/transactions?dateFrom=2026-10-31T05:00:00Z&dateTo=2026-10-01T05:00:00Z

### Create sale (price comes from the product)
POST {{TransactionService_HostAddress}}/api/transactions
Content-Type: application/json

{
  "transactionType": "SALE",
  "productId": 2,
  "quantity": 2,
  "detail": "Venta en mostrador"
}

### Create sale exceeding stock (expects 409)
POST {{TransactionService_HostAddress}}/api/transactions
Content-Type: application/json

{
  "transactionType": "SALE",
  "productId": 2,
  "quantity": 999
}

### Create purchase (unit price required)
POST {{TransactionService_HostAddress}}/api/transactions
Content-Type: application/json

{
  "transactionType": "PURCHASE",
  "productId": 2,
  "quantity": 10,
  "unitPrice": 26.00,
  "detail": "Reposición de denim"
}

### Create purchase without unit price (expects 400)
POST {{TransactionService_HostAddress}}/api/transactions
Content-Type: application/json

{
  "transactionType": "PURCHASE",
  "productId": 2,
  "quantity": 10
}

### Update transaction (use the id returned by the create calls)
PUT {{TransactionService_HostAddress}}/api/transactions/10
Content-Type: application/json

{
  "quantity": 3,
  "detail": "Venta corregida"
}

### Delete transaction
DELETE {{TransactionService_HostAddress}}/api/transactions/10

### Edit seed purchase below what was already sold (expects 409)
PUT {{TransactionService_HostAddress}}/api/transactions/3
Content-Type: application/json

{ "quantity": 2 }

### Delete seed purchase already consumed (expects 409)
DELETE {{TransactionService_HostAddress}}/api/transactions/3